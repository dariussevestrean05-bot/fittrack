# Normalisierung: LF im Repo, CRLF nur auf Windows-Checkout
* text=auto

*.js   text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.gradle text eol=lf
gradlew text eol=lf
*.bat  text eol=crlf

*.png binary
*.jpg binary
*.jar binary
*.apk binary
